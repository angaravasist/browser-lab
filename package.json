{
  "name": "browserlab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, Docker-first manual browser compatibility testing on real, verified browser versions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:grid": "node --test tests/integration/grid-contract.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run build -w apps/web",
    "catalog:toml": "node scripts/gen-grid-toml.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
