# Copy to .env and adjust only if needed. No secrets are required for a local install.

# Where the UI/API is published. Keep 127.0.0.1 unless you deliberately run a trusted-LAN setup behind
# authentication/TLS (see docs/SECURITY-AND-PRIVACY.md). 0.0.0.0 exposes browser control to your network.
BROWSERLAB_PORT=3000
BROWSERLAB_BIND_HOST=127.0.0.1

BROWSERLAB_MAX_CONCURRENT_SESSIONS=2
BROWSERLAB_IDLE_TIMEOUT_MINUTES=30
BROWSERLAB_MAX_SESSION_MINUTES=120
BROWSERLAB_MAX_TRANSFER_MB=25
# Evidence (screenshots, saved downloads) is deleted this many days after its session ended. 0 keeps it forever.
BROWSERLAB_RETENTION_DAYS=30
# Allow localhost/private-network targets (needed for local apps and internal staging). Turn off if untrusted
# people can reach this BrowserLab: browsers would otherwise give them a path into your network.
BROWSERLAB_TRUSTED_PRIVATE_URLS=true
BROWSERLAB_LOG_LEVEL=info

# default = current Firefox/Chrome/Edge; legacy = also Chrome 109, Edge 121, Firefox 115 ESR (amd64 hosts;
# use with compose.legacy-amd64.yaml which also builds the ESR image).
BROWSERLAB_GRID_PROFILE=default

# Workers: name=url pairs. Extra workers are reached through SSH tunnels (compose.remote-workers.example.yaml).
BROWSERLAB_GRID_URLS=local=http://grid:4444
# Extra browser origins allowed to use the API/viewer (only for a reverse proxy in front of BrowserLab).
BROWSERLAB_PUBLIC_ORIGINS=

# Safari Mac worker (docs/SAFARI-WORKER.md). The VNC password stays server-side; it is never sent to browsers.
BROWSERLAB_SAFARI_VNC=
BROWSERLAB_SAFARI_VNC_PASSWORD=
# Only while running the one-time manual validation in docs/SAFARI-WORKER.md.
BROWSERLAB_SAFARI_VALIDATION_MODE=false
